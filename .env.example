# Пример переменных окружения. Скопируйте в .env и подставьте свои значения.
#   cp .env.example .env

# ── База данных (libSQL / Turso) ──────────────────────────────────────────
# ПРОДАКШН (Vercel + Turso). Значения — на странице базы в https://turso.io
# (app → ваша БД → "Settings" → "libSQL connection strings"):
DATABASE_URL="libsql://<имя-базы>-<id>.turso.io"
TURSO_AUTH_TOKEN="<токен доступа к базе>"

# Один раз применить схему к Turso (с указанными выше DATABASE_URL и TURSO_AUTH_TOKEN):
#   bun run db:push

# ЛОКАЛЬНАЯ разработка (файл SQLite) — закомментируйте две строки выше и
# раскомментируйте строку ниже. ВАЖНО: используйте АБСОЛЮТНЫЙ путь.
# Prisma CLI разрешает относительные file:-пути от папки prisma/, а libSQL adapter —
# от корня проекта; с относительным путём `bun run db:push` создаст БД в prisma/db/,
# а приложение будет искать её в db/. АБСОЛЮТНЫЙ путь устраняет рассинхронизацию.
# DATABASE_URL="file:/полный/путь/к/проекту/db/custom.db"
# TURSO_AUTH_TOKEN для локального файла не нужен.

# ── NextAuth ───────────────────────────────────────────────────────────────
# Случайная строка для подписи JWT. Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Базовый URL приложения. Локально — http://localhost:3000;
# на Vercel — адрес вашего деплоя, например https://lit-xx.vercel.app
NEXTAUTH_URL="http://localhost:3000"
